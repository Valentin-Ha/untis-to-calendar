# WebUntis Zugang
# Werte mit $, # oder Leerzeichen in einfache Anführungszeichen setzen, z. B. PASSWORD='ab$cd'
SERVER=
USERNAME=
PASSWORD=
SCHOOL=

# optional
USERAGENT=

# Ausgabe-Modus: local | docker | caldav, mehrere mit Komma, z. B. docker,caldav
MODE=docker

# Pfade optional
CALENDAR_FILE=./stundenplan.ics
DATA_DIR=/data

# Zeitzone der Stundenplan-Zeiten
TIMEZONE=Europe/Berlin

# Irreguläre Stunden (Vertretung, verlegte Stunde) ebenfalls als Ausfall markieren: true | false
IRREGULAR_AS_CANCELLED=false

# CalDAV (nur für MODE=caldav)
CALDAV_URL=
CALDAV_USERNAME=
CALDAV_PASSWORD=
CALDAV_CALENDAR=Stundenplan

# Update-Intervall in Minuten
UPDATE_INTERVAL=15
